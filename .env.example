# Standalone Docker / local runs. Copy to .env and fill in. Never commit .env or share it.
ANTHROPIC_API_KEY=

# Live mode only. Kraken -> Settings -> API. Permissions: Query Funds, Query Open Orders & Trades,
# Query Closed Orders & Trades, Create & Modify Orders. NEVER enable "Withdraw Funds".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Scheduler (Docker)
TZ=Europe/Warsaw
RUN_TIME=08:05
REFRESH_MINUTES=15
LIVE=false
BOT_LANGUAGE=en
# purchase prices (EUR per 1 coin) of coins bought outside the bot, e.g. {"XBTEUR": 65617}
ENTRY_PRICES={}

# Optional: publish entities to a Home Assistant instance. Also set home_assistant.enabled
# and home_assistant.url in data/config.json. HA -> Profile -> Security -> Long-lived access tokens.
HA_TOKEN=
